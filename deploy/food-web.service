[Unit]
Description=Elder fall monitor web UI (app.py)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/admin/food_project
ExecStart=/usr/bin/python3 /home/admin/food_project/app.py
Restart=always
RestartSec=3
StandardOutput=append:/home/admin/food_project/webapp.log
StandardError=append:/home/admin/food_project/webapp.log

[Install]
WantedBy=default.target
